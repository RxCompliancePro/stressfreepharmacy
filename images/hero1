<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080" role="img" aria-label="Urgent pharmacy compliance service hero image">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0c2b4f"/>
      <stop offset="45%" stop-color="#0e4b78"/>
      <stop offset="100%" stop-color="#1f7ea8"/>
    </linearGradient>

    <radialGradient id="glow" cx="35%" cy="35%" r="60%">
      <stop offset="0%" stop-color="#bdefff" stop-opacity="0.8"/>
      <stop offset="100%" stop-color="#bdefff" stop-opacity="0"/>
    </radialGradient>

    <linearGradient id="panel" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#12365d" stop-opacity="0.9"/>
      <stop offset="100%" stop-color="#0a1f3e" stop-opacity="0.88"/>
    </linearGradient>

    <linearGradient id="accent" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#9e1f2d" stop-opacity="0.92"/>
      <stop offset="100%" stop-color="#cf3f4a" stop-opacity="0.85"/>
    </linearGradient>

    <filter id="softBlur" x="-10%" y="-10%" width="120%" height="120%">
      <feGaussianBlur stdDeviation="22"/>
    </filter>

    <filter id="grain" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="12"/>
      <feColorMatrix type="saturate" values="0"/>
      <feComponentTransfer>
        <feFuncA type="table" tableValues="0 0.05"/>
      </feComponentTransfer>
    </filter>
  </defs>

  <rect width="1920" height="1080" fill="url(#bg)"/>
  <circle cx="700" cy="280" r="520" fill="url(#glow)" opacity="0.75"/>

  <!-- Soft bokeh highlights -->
  <g fill="#d2f5ff" opacity="0.33" filter="url(#softBlur)">
    <circle cx="260" cy="190" r="66"/>
    <circle cx="420" cy="120" r="52"/>
    <circle cx="1330" cy="220" r="82"/>
    <circle cx="1650" cy="340" r="94"/>
    <circle cx="1480" cy="620" r="120"/>
    <circle cx="1750" cy="710" r="76"/>
  </g>

  <!-- Medical cross + urgency clock motif -->
  <g transform="translate(440 360)">
    <circle cx="0" cy="0" r="200" fill="none" stroke="#eaf8ff" stroke-width="11" opacity="0.55"/>
    <line x1="0" y1="0" x2="0" y2="-115" stroke="#f5fbff" stroke-width="12" stroke-linecap="round" opacity="0.75"/>
    <line x1="0" y1="0" x2="98" y2="46" stroke="#f5fbff" stroke-width="12" stroke-linecap="round" opacity="0.75"/>
    <rect x="-125" y="-34" width="250" height="68" rx="16" fill="#f2fbff" opacity="0.9"/>
    <rect x="-34" y="-125" width="68" height="250" rx="16" fill="#f2fbff" opacity="0.9"/>
  </g>

  <!-- Abstract pharmacist/clipboard panel for right side depth -->
  <g>
    <rect x="1070" y="170" width="760" height="840" rx="34" fill="url(#panel)"/>
    <rect x="1140" y="250" width="620" height="690" rx="28" fill="#2c6b95" opacity="0.33"/>
    <polygon points="1260,840 1550,390 1720,840" fill="#f1f8ff" opacity="0.2"/>
  </g>

  <!-- Urgent action stripe -->
  <rect x="0" y="840" width="1320" height="240" fill="url(#accent)" opacity="0.55"/>

  <!-- subtle line texture -->
  <g stroke="#ffffff" stroke-opacity="0.08" stroke-width="2">
    <line x1="-80" y1="0" x2="1000" y2="1080"/>
    <line x1="90" y1="0" x2="1170" y2="1080"/>
    <line x1="260" y1="0" x2="1340" y2="1080"/>
    <line x1="430" y1="0" x2="1510" y2="1080"/>
    <line x1="600" y1="0" x2="1680" y2="1080"/>
  </g>

  <rect width="1920" height="1080" filter="url(#grain)" opacity="0.45"/>
</svg>
